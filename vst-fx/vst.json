{
  "name": "[FX] Oneiroi FX",
  "vendor": "Befaco",
  "uid": "BfOx",
  "version": 1100,
  "so": "oneiroi_fx.so",
  "presets": "presets.json",
  "effect": true,
  "defines": {
    "HAS_SONG_POS": 1
  },
  "build": {
    "root": "..",
    "sources": [
      "engine/mpc/oneiroi_engine.cc"
    ],
    "cflags": [
